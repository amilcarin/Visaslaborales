rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Use a more robust check that allows the specific admin emails directly too
      // to avoid race conditions during bootstrapping
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email in ["amilcaralvarado330@gmail.com", "admin@visaexpert.com"]
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTracking(data) {
      return data.trackingId is string && data.trackingId.size() <= 40
        && data.applicantName is string && data.applicantName.size() <= 200
        && data.currentStep is int && data.currentStep >= 1 && data.currentStep <= 7
        && data.steps is list && data.steps.size() == 7;
    }

    // Admins Collection
    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create: if isSignedIn() 
        && request.auth.token.email in ["amilcaralvarado330@gmail.com", "admin@visaexpert.com"];
    }

    // Connection test document rule
    match /test/connection {
      allow read: if true;
    }

    // Visa Applications Rules
    match /visaApplications/{applicationId} {
      // Allow public GET if they have the specific ID. 
      // Do NOT allow LIST to prevent scraping applications.
      allow get: if isValidId(applicationId);
      
      // Default deny for others
      allow list: if false;
      allow write: if isAdmin();
    }

    // Prospects Rules
    match /prospects/{prospectId} {
      // Allow anybody to create a prospect (public form)
      allow create: if isValidId(prospectId) 
        && request.resource.data.nombre is string 
        && request.resource.data.telefono is string
        && request.resource.data.trackingCode is string
        && request.resource.data.createdAt == request.time;
        
      // Only admins or specific users could read (disabled for now for privacy)
      allow read, update, delete: if isAdmin();
    }

    // Tracking Rules
    match /tracking/{trackingId} {
      // Allow creation during registration
      allow create: if isValidId(trackingId)
        && request.resource.data.trackingId == trackingId
        && request.resource.data.applicantName is string
        && request.resource.data.currentStep == 1
        && request.resource.data.createdAt == request.time;
      
      // Allow public GET to see their own status
      allow get: if isValidId(trackingId);
      
      // Update by admin
      allow update: if isAdmin() && isValidTracking(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentStep', 'lastUpdated', 'steps'])
        && request.resource.data.lastUpdated == request.time;

      allow list: if isAdmin();
      allow delete: if false;
    }

    // Chat Sessions Rules
    match /chat_sessions/{sessionId} {
      allow create: if isValidId(sessionId)
        && request.resource.data.status is string
        && request.resource.data.createdAt == request.time;
      allow get: if true;
      allow list: if false; // Users shouldn't list sessions
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastMessageAt', 'requestType']))
        && (request.resource.data.status in ["ai", "waiting_advisor", "active_advisor", "closed"]);
      
      match /messages/{messageId} {
        allow create: if isValidId(messageId)
          && request.resource.data.role in ["user", "ai", "agent"]
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow list, get: if true;
      }
    }

    // Advisor Support Requests Rules
    match /advisor_support_requests/{requestId} {
      allow create: if request.resource.data.sessionId is string
        && request.resource.data.status == "pending"
        && request.resource.data.requestedAt == request.time;
      allow read, update: if false; // Only agents via admin dashboard
    }
  }
}
